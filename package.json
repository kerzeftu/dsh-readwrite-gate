{
  "name": "dsh-readwrite-gate",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Adds no-access and read-and-write-inside-workspace permission levels with a separate read/write authorization dialog.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerzeftu/dsh-readwrite-gate.git"
  },
  "homepage": "https://github.com/kerzeftu/dsh-readwrite-gate#readme",
  "bugs": {
    "url": "https://github.com/kerzeftu/dsh-readwrite-gate/issues"
  },
  "exports": {
    ".": "./index.js",
    "./functions": "./functions.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "functions.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "cordis",
    "permission",
    "sandbox",
    "access-control",
    "plugin"
  ],
  "author": "kerzeftu",
  "scripts": {
    "test": "node test/run-all.mjs"
  }
}
