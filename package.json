{
  "name": "@local/dsh-access-permission",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Adds no-access and view-inside-workspace permission levels with a separate read/write authorization dialog.",
  "exports": {
    ".": "./index.js",
    "./functions": "./functions.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "functions.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "test/delegation.test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
